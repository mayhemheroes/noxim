# getWirelessDistance, prefersWirelessPath, GetNodesInRegion) from other/ttable_from_hub.cpp.
# Replaces the original dead mayhem/fuzz.cpp harness.
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/ttable-parse/testsuite

cmds:
  - cmd: /mayhem/fuzz
    libfuzzer: true
